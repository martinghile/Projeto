{
  "name": "psi-saas-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/whatsapp"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,DESKTOP -c blue,green \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "dev:whatsapp": "npm --workspace apps/whatsapp run dev",
    "build": "npm run build:web && npm run build:desktop && npm run build:whatsapp",
    "build:web": "npm --workspace apps/web run build",
    "build:desktop": "npm --workspace apps/desktop run build",
    "build:whatsapp": "npm --workspace apps/whatsapp run build",
    "check": "npm --workspace apps/web run check && npm --workspace apps/whatsapp run check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "supabase": "^2.77.0",
    "to-ico": "^1.1.5"
  }
}
